{
  "root": true,
  "env": {
    "browser": true,
    "es2022": true,
    "vitest": true
  },
  "parserOptions": {
    "ecmaVersion": 2022,
    "sourceType": "module",
    "ecmaFeatures": { "jsx": true }
  },
  "extends": ["eslint:recommended", "plugin:react-hooks/recommended"],
  "rules": {
    "no-console": "off"
  }
}
